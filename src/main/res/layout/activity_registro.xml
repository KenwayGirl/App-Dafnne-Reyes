<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F7F4EF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp">

        <ImageView
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:src="@android:drawable/ic_lock_idle_lock"
            android:contentDescription="Escudo de Seguridad" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registro"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="24dp" />

        <!-- Campo 1: Nombre de Usuario -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👤 Nombre de Usuario"
            android:textSize="14sp"
            android:textColor="#222222"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etRegUsuario"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@android:drawable/editbox_background_normal"
            android:hint="Jorge Perez..."
            android:inputType="text"
            android:padding="12dp"
            android:layout_marginBottom="18dp" />

        <!-- Campo 2: Contraseña -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔑 Contraseña"
            android:textSize="14sp"
            android:textColor="#222222"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etRegPassword"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@android:drawable/editbox_background_normal"
            android:hint="(6 caracteres minimo)"
            android:inputType="textPassword"
            android:padding="12dp"
            android:layout_marginBottom="18dp" />

        <!-- Campo 3: Confirmar Contraseña -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔒 Confirmar Contraseña"
            android:textSize="14sp"
            android:textColor="#222222"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etRegConfirmar"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@android:drawable/editbox_background_normal"
            android:hint="Repita su contraseña"
            android:inputType="textPassword"
            android:padding="12dp"
            android:layout_marginBottom="28dp" />

        <!-- Botón REGISTRAR CUENTA -->
        <Button
            android:id="@+id/btnRegistrarCuenta"
            android:layout_width="220dp"
            android:layout_height="55dp"
            android:text="REGISTRAR CUENTA"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#637338"
            android:layout_marginBottom="20dp" />

        <!-- Volver a Iniciar Sesión -->
        <TextView
            android:id="@+id/tvVolverLogin"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="¿Ya tienes una cuenta? Iniciar Sesión"
            android:textSize="14sp"
            android:textColor="#000000"
            android:padding="8dp" />

    </LinearLayout>
</ScrollView>