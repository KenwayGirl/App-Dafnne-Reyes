<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F4EF">

    <!-- Contenido Superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registro de Alertas"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="22dp" />

        <!-- 3 Tarjetas de Historial (Con contraste corregido #5C574F) -->
        <TextView
            android:id="@+id/tvAlerta1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#5C574F"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:padding="16dp"
            android:textSize="13sp"
            android:text="🔴 18/10/2026 - 23:15 hrs\nSensor Sonido: Ruido fuerte\n(Persiana Bajada)"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvAlerta2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#5C574F"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:padding="16dp"
            android:textSize="13sp"
            android:text="🔴 18/10/2026 - 21:40 hrs\nSensor PIR: Movimiento detectado"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvAlerta3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#5C574F"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:padding="16dp"
            android:textSize="13sp"
            android:text="🟢 18/10/2026 - 20:00 hrs\nSistema Activado\n(Usuario: admin)"
            android:layout_marginBottom="26dp" />

        <Button
            android:id="@+id/btnActualizar"
            android:layout_width="220dp"
            android:layout_height="55dp"
            android:layout_gravity="center_horizontal"
            android:text="🔄 ACTUALIZAR DATOS"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#8A682D"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnBorrar"
            android:layout_width="220dp"
            android:layout_height="55dp"
            android:layout_gravity="center_horizontal"
            android:text="🗑️ BORRAR HISTORIAL"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#802F2F" />
    </LinearLayout>

    <!-- BARRA DE NAVEGACIÓN INFERIOR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:background="#D9D9D9"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Pestaña 1: Panel (INACTIVA) -->
        <LinearLayout
            android:id="@+id/navPanel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏠🛡️"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Panel"
                android:textSize="11sp"
                android:textColor="#333333" />

            <View
                android:layout_width="55dp"
                android:layout_height="4dp"
                android:background="#8C857B"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Pestaña 2: Historial (ACTIVA EN VERDE) -->
        <LinearLayout
            android:id="@+id/navHistorial"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋🔔"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alertas"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#1F4D14" />

            <View
                android:layout_width="55dp"
                android:layout_height="4dp"
                android:background="#2E6B1E"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Pestaña 3: Cerrar Sesión -->
        <LinearLayout
            android:id="@+id/navSalir"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👤🚪"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Salir"
                android:textSize="11sp"
                android:textColor="#333333" />

            <View
                android:layout_width="55dp"
                android:layout_height="4dp"
                android:background="#8C857B"
                android:layout_marginTop="4dp" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>