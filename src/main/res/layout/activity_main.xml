<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="#F5F5F5">

    <ImageView
        android:id="@+id/imgEscudo"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:src="@android:drawable/ic_lock_idle_lock"
        android:contentDescription="Escudo de Seguridad" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Control de Seguridad - Tienda"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="36dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="👤 Usuario"
        android:textSize="16sp"
        android:textColor="#555555"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/etUsuario"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@android:drawable/editbox_background_normal"
        android:hint="Ingrese su usuario"
        android:inputType="text"
        android:padding="12dp"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔑 Contraseña"
        android:textSize="16sp"
        android:textColor="#555555"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/etPassword"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@android:drawable/editbox_background_normal"
        android:hint="Ingrese su contraseña"
        android:inputType="textPassword"
        android:padding="12dp"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnIniciarSesion"
        android:layout_width="180dp"
        android:layout_height="55dp"
        android:text="INICIAR\nSESIÓN"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:backgroundTint="#1E3F20"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvRegistrar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Crear cuenta / Registrar"
        android:textSize="14sp"
        android:textColor="#333333"
        android:padding="8dp"
        android:layout_marginBottom="40dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Protegido bajo estándar ISO 27400"
        android:textSize="11sp"
        android:textColor="#444444" />

</LinearLayout>